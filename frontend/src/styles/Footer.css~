.footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: linear-gradient(135deg, darkslategray, #2c3e50);
    padding: 2rem 5%;
    color: white;
    margin-top: auto;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
}

.footer-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 250px;
}

.footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
}

.footer-bottom {
    text-align: center;
    width: 100%;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

@media (max-width: 768px) {
    .footer-content {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .footer-nav {
        justify-content: center;
    }
}