import React, { useState } from "react";
import { request } from "../axios_helper";
import { useAuth } from "../context/AuthProvider";
import { Button, Box, Modal, Typography } from "@mui/material";
import { toast } from "react-hot-toast";
import dayjs from "dayjs";
import { getStatusText } from "../util/ui";

export default function AthleteTimeSlots({ timeSlots, setTimeSlots }) {
    const { user } = useAuth();
    const [selectedTimeSlot, setSelectedTimeSlot] = useState(null);
    const [isModalOpen, setIsModalOpen] = useState(false);

    const filteredTimeSlots = timeSlots.filter(slot =>
        slot.status !== "CANCELLED" && slot.status !== "IN_PROGRESS"
    );

    const groupedByCoach = filteredTimeSlots.reduce((acc, slot) => {
        const coachKey = `${slot.coach.firstName} ${slot.coach.lastName}`;
        if (!acc[coachKey]) {
            acc[coachKey] = [];
        }
        acc[coachKey].push(slot);
        return acc;
    }, {});

    const handleSlotClick = (slot) => {
        setSelectedTimeSlot(slot);
        setIsModalOpen(true);
    };

    const handleJoin = () => {
        const toastId = toast.loading("Запись на тренировку...");
        request("PATCH", `trainings/${selectedTimeSlot.id}/join/${user.id}`)
            .then(() => {
                const updatedSlots = timeSlots.map((slot) =>
                    slot.id === selectedTimeSlot.id
                        ? { ...slot, athletes: [...slot.athletes, user] }
                        : slot
                );
                setTimeSlots(updatedSlots);
                setIsModalOpen(false);
                toast.success("Вы успешно записаны!", { id: toastId });
            })
            .catch(() => {
                toast.error("Ошибка записи", { id: toastId });
            });
    };

    const handleCancel = () => {
        const toastId = toast.loading("Отмена записи...");
        request("PATCH", `trainings/${selectedTimeSlot.id}/cancel/${user.id}`)
            .then(() => {
                const updatedSlots = timeSlots.map((slot) =>
                    slot.id === selectedTimeSlot.id
                        ? {
                            ...slot,
                            athletes: slot.athletes.filter((a) => a.id !== user.id),
                        }
                        : slot
                );
                setTimeSlots(updatedSlots);
                setIsModalOpen(false);
                toast.success("Запись отменена", { id: toastId });
            })
            .catch(() => {
                toast.error("Ошибка отмены", { id: toastId });
            });
    };

    const formatTimeRange = (start, end) =>
        `${dayjs(start).format("HH:mm")} - ${dayjs(end).format("HH:mm")}`;

    return (
        <Box sx={{ width: "100%", p: 2 }}>
            {Object.entries(groupedByCoach).map(([coach, slots]) => {
                const sortedSlots = [...slots].sort((a, b) =>
                    dayjs(a.start).unix() - dayjs(b.start).unix()
                );

                return (
                    <Box key={coach} sx={{ mb: 4 }}>
                        <Typography
                            variant="h6"
                            sx={{
                                mb: 2,
                                fontWeight: 600,
                                color: 'text.primary',
                                letterSpacing: 0.5
                            }}
                        >
                            {coach}
                        </Typography>
                        <Box sx={{ display: "flex", flexWrap: "wrap", gap: 1.5 }}>
                            {sortedSlots.map((slot) => {
                                const isEnrolled = slot.athletes.some((a) => a.id === user.id);
                                const isFull = slot.athletes.length >= slot.maxAthletes;
                                const isDisabled = isFull && !isEnrolled;

                                return (
                                    <Button
                                        key={slot.id}
                                        variant={isEnrolled ? "contained" : "outlined"}
                                        onClick={() => handleSlotClick(slot)}
                                        disabled={isDisabled}
                                        sx={{
                                            m: 0.5,
                                            padding: '8px 16px',
                                            borderRadius: '10px',
                                            textTransform: 'none',
                                            fontWeight: 500,
                                            letterSpacing: 0.2,
                                            border: '2px solid',
                                            borderColor: isEnrolled ? 'primary.main' : 'grey.300',
                                            bgcolor: isEnrolled
                                                ? 'primary.main'
                                                : isFull
                                                    ? 'grey.200'
                                                    : 'white',
                                            color: isEnrolled
                                                ? 'white'
                                                : isFull
                                                    ? 'grey.700'
                                                    : 'primary.main',
                                            transition: 'all 0.3s ease',
                                            '&:hover': {
                                                border: '2px solid',
                                                borderColor: isEnrolled
                                                    ? 'primary.dark'
                                                    : 'primary.main',
                                                bgcolor: isEnrolled
                                                    ? 'primary.dark'
                                                    : isFull
                                                        ? 'grey.300'
                                                        : 'primary.light',
                                                transform: !isDisabled && 'translateY(-2px)',
                                                boxShadow: !isDisabled && '0 4px 12px rgba(0,0,0,0.1)',
                                            },
                                            '&:disabled': {
                                                opacity: 0.6,
                                                cursor: 'not-allowed'
                                            }
                                        }}
                                    >
                                        {slot.name} ({formatTimeRange(slot.start, slot.end)})
                                    </Button>
                                );
                            })}
                        </Box>
                    </Box>
                );
            })}

            <Modal
                open={isModalOpen}
                onClose={() => setIsModalOpen(false)}
                aria-labelledby="training-details-modal"
            >
                <Box
                    sx={{
                        position: "absolute",
                        top: "50%",
                        left: "50%",
                        transform: "translate(-50%, -50%)",
                        width: { xs: "90%", sm: 450 },
                        bgcolor: "background.paper",
                        boxShadow: '0 8px 32px rgba(0,0,0,0.2)',
                        p: 4,
                        borderRadius: "16px",
                        maxHeight: "80vh",
                        overflowY: "auto",
                    }}
                >
                    {selectedTimeSlot && (
                        <>
                            <Typography
                                id="training-details-modal"
                                variant="h5"
                                sx={{
                                    mb: 3,
                                    fontWeight: 700,
                                    color: 'text.primary',
                                    letterSpacing: 0.3
                                }}
                            >
                                {selectedTimeSlot.name}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Описание:</strong>{" "}
                                {selectedTimeSlot.description || "Описание отсутствует"}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Дата и время:</strong>{" "}
                                {dayjs(selectedTimeSlot.start).format("DD.MM.YYYY HH:mm")} -{" "}
                                {dayjs(selectedTimeSlot.end).format("HH:mm")}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Тренер:</strong> {selectedTimeSlot.coach.firstName}{" "}
                                {selectedTimeSlot.coach.lastName}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Макс. участников:</strong> {selectedTimeSlot.maxAthletes}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Записано:</strong> {selectedTimeSlot.athletes.length}
                            </Typography>
                            <Typography
                                variant="body1"
                                sx={{
                                    mb: 2,
                                    color: 'text.secondary',
                                    lineHeight: 1.6
                                }}
                            >
                                <strong>Статус:</strong> {getStatusText(selectedTimeSlot.status)}
                            </Typography>

                            <Box sx={{ display: "flex", gap: 2, mt: 3 }}>
                                {selectedTimeSlot.athletes.some((a) => a.id === user.id) ? (
                                    <Button
                                        variant="contained"
                                        color="error"
                                        onClick={handleCancel}
                                        sx={{
                                            flex: 1,
                                            py: 1.5,
                                            borderRadius: '10px',
                                            transition: 'all 0.3s ease',
                                            '&:hover': {
                                                transform: 'translateY(-2px)',
                                                boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                            }
                                        }}
                                    >
                                        Отменить запись
                                    </Button>
                                ) : !(
                                    selectedTimeSlot.athletes.length >= selectedTimeSlot.maxAthletes
                                ) ? (
                                    <Button
                                        variant="contained"
                                        color="success"
                                        onClick={handleJoin}
                                        sx={{
                                            flex: 1,
                                            py: 1.5,
                                            borderRadius: '10px',
                                            transition: 'all 0.3s ease',
                                            '&:hover': {
                                                transform: 'translateY(-2px)',
                                                boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                            }
                                        }}
                                    >
                                        Записаться
                                    </Button>
                                ) : null}
                                <Button
                                    variant="outlined"
                                    onClick={() => setIsModalOpen(false)}
                                    sx={{
                                        flex: 1,
                                        py: 1.5,
                                        borderRadius: '10px',
                                        transition: 'all 0.3s ease',
                                        '&:hover': {
                                            transform: 'translateY(-2px)',
                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)',
                                            borderColor: 'grey.500'
                                        }
                                    }}
                                >
                                    Закрыть
                                </Button>
                            </Box>
                        </>
                    )}
                </Box>
            </Modal>
        </Box>
    );
}
