import React from 'react';
import {Box, Modal, Typography, Select, MenuItem, IconButton, Button} from "@mui/material";
import {ClearIcon} from "@mui/x-date-pickers";

const modalStyle = {
    position: "absolute",
    top: "50%",
    left: "50%",
    transform: "translate(-50%, -50%)",
    width: 450,
    bgcolor: "background.paper",
    boxShadow: 24,
    p: 4,
    // borderRadius: "16px"
};

export default function TimeSlotModal({
                                          isOpen,
                                          onClose,
                                          selectedTimeSlot,
                                          handleStatusChange,
                                          handleRemoveAthlete
                                      }) {
    return (
        <Modal open={isOpen} onClose={onClose}>
            <Box sx={modalStyle}>
                {selectedTimeSlot && (
                    <>
                        <Typography variant="h5" sx={{mb: 3}}>
                            {selectedTimeSlot.name}
                        </Typography>

                        <Box sx={{mb: 2, display: 'flex', alignItems: 'center', gap: 1}}>
                            <Typography variant="body1" component="span">
                                <strong>Статус:</strong>
                            </Typography>
                            <Select
                                value={selectedTimeSlot.status}
                                onChange={(e) => handleStatusChange({ status: e.target.value })}
                                sx={{minWidth: 120}}
                            >
                                <MenuItem value="SCHEDULED">Запланирована</MenuItem>
                                <MenuItem value="IN_PROGRESS">В процессе</MenuItem>
                                <MenuItem value="CANCELLED">Отменена</MenuItem>
                                <MenuItem value="COMPLETED">Завершена</MenuItem>
                            </Select>
                        </Box>

                        <Typography variant="body1" sx={{mb: 2}}>
                            <strong>Участники:</strong>
                        </Typography>

                        <Box sx={{maxHeight: 200, overflowY: "auto", mb: 2}}>
                            {selectedTimeSlot.athletes.length > 0 ? (
                                <ul>
                                    {selectedTimeSlot.athletes.map(athlete => (
                                        <li key={athlete.id} style={{
                                            display: "flex",
                                            justifyContent: "space-between",
                                            alignItems: "center"
                                        }}>
                                            {athlete.firstName} {athlete.lastName}
                                            <IconButton
                                                onClick={() => handleRemoveAthlete(athlete.id)}
                                                size="small"
                                            >
                                                <ClearIcon fontSize="small"/>
                                            </IconButton>
                                        </li>
                                    ))}
                                </ul>
                            ) : "Нет участников"}
                        </Box>

                        <Button
                            variant="contained"
                            onClick={onClose}
                            sx={{mt: 2}}
                        >
                            Закрыть
                        </Button>
                    </>
                )}
            </Box>
        </Modal>
    );
};

